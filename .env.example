# Database Connection (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/StayBooking?retryWrites=true&w=majority
ATLASDB_URL=mongodb://127.0.0.1:27017/StayBooking

# Session Storage Secret
SECRET=your_super_secret_session_key_here

# Cloudinary Credentials (for listing image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox / Location API Token (for interactive map rendering)
MAP_TOKEN=your_mapbox_public_token_here

# Server Port (optional, defaults to 8080)
PORT=8080
